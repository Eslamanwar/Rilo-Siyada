# Port the server listens on
PORT=3200

# AWS region for Bedrock
# Use me-central-1 for UAE production — eu-west-1 for dev/fallback
BEDROCK_REGION=eu-west-1

# Bedrock Claude Haiku model ID (matches the region prefix)
BEDROCK_MODEL=eu.anthropic.claude-haiku-4-5-20251001-v1:0

# AWS credentials — only needed for local dev (EC2 uses instance role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
