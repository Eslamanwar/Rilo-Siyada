# Port the server listens on
PORT=3200

# AWS region for Bedrock
# Use me-central-1 for UAE production — eu-west-1 for dev/fallback
BEDROCK_REGION=eu-west-1

# Bedrock Claude Haiku model ID (matches the region prefix)
BEDROCK_MODEL=eu.anthropic.claude-haiku-4-5-20251001-v1:0

# Audit ledger file (default server/data/ledger.jsonl)
LEDGER_FILE=

# Key sealing ledger entries and evidence packs. Left empty, a 0600 key file is
# generated next to the ledger on first run; set it here (or in a secret store)
# to keep the key off the same disk as the chain it protects.
SIYADA_LEDGER_KEY=

# AWS credentials — only needed for local dev (EC2 uses instance role)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
